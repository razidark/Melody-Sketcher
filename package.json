{
  "name": "rzl-melody-sketcher",
  "private": true,
  "version": "1.0.14",
  "description": "High-Fidelity Creative Audio Workstation (RZL Apps)",
  "author": "RZL Apps",
  "type": "module",
  "main": "electron.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "preelectron:dev": "node prebuild.js",
    "electron:dev": "vite build && electron .",
    "preelectron:build": "node prebuild.js",
    "electron:build": "vite build && npx electron-builder"
  },
  "dependencies": {
    "firebase": "^12.13.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@midi-json-tools/json-to-midi": "^2.1.0",
    "@midi-json-tools/midi-to-json": "^2.1.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "electron": "42.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.12"
  },
  "build": {
    "appId": "com.melodysketcher.app",
    "productName": "Melody Sketcher Studio",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "dist/**/*",
      "electron.cjs"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
